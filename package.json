{
  "name": "apollo-software-library",
  "private": true,
  "description": "Working recreations of Apollo-era software, starting with the MSC view program (NASA TN D-6853).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rblalock/apollo-software-library.git"
  },
  "homepage": "https://apollo-software-library.vercel.app",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/view-engine --noEmit",
    "dev": "bun scripts/sync-public.ts && cd site && bun run dev",
    "build": "bun scripts/sync-public.ts && cd site && bun run build",
    "check:site": "cd site && bun run check",
    "typecheck:scripts": "tsc -p scripts --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
