---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const limits = await getCollection('limits');
  return limits.map((page) => ({ params: { entry: page.id }, props: { page } }));
}

interface Props { page: CollectionEntry<'limits'> }
const { page } = Astro.props;
const entry = await getEntry('entries', page.id);
if (!entry) throw new Error(`limits page ${page.id}: no entry with that id`);
const { Content } = await render(page);
---
<Base title={`${page.data.title} · ${entry.data.title}`} description={page.data.summary}>
  <p class="font-mono text-xs uppercase tracking-widest text-muted"><a class="hover:underline" href={`/${entry.id}/`}>{entry.data.title}</a> / Limits</p>
  <h1 class="mt-2 max-w-4xl text-3xl font-semibold tracking-tight">{page.data.title}</h1>
  <p class="mt-3 max-w-3xl text-stone-700 dark:text-stone-300">{page.data.summary}</p>
  <article class="prose-lite mt-8"><Content /></article>
</Base>
