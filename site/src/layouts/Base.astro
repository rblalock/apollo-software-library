---
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Working recreations of Apollo-era software, each with its history and primary sources.' } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = `${title} · Apollo Software Library`;
const pageUrl = new URL(path, Astro.site);
const imageUrl = new URL('/og.png', Astro.site);
const nav = [
  { href: '/', label: 'Library' },
  { href: '/view-program/film/', label: 'Film' },
  { href: '/view-program/', label: 'View program' },
  { href: '/documents/', label: 'Sources' },
];
const current = (href: string) => {
  if (href === '/') return path === '/';
  // The most specific item wins: on the film page only "Film" is current, not "View program" too.
  const best = nav.filter((n) => n.href !== '/' && path.startsWith(n.href)).sort((x, y) => y.href.length - x.href.length)[0];
  return best?.href === href;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apollo Software Library" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Apollo Software Library: working recreations of Apollo-era software. Beside the title, the Earth drawn in white lines on black, as the view program drew it." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <a href="#main" class="sr-only rounded bg-ink px-3 py-2 text-paper focus:not-sr-only focus:absolute focus:left-4 focus:top-4">Skip to content</a>
    <header class="border-b border-rule">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-4 px-4 py-4" aria-label="Site">
        <a href="/" class="font-mono text-sm font-medium uppercase tracking-widest">Apollo Software Library</a>
        <ul class="flex gap-5 font-mono text-xs uppercase tracking-wider">
          {nav.map((n) => (
            <li><a href={n.href} class:list={['hover:underline', current(n.href) && 'text-accent']} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl border-t border-rule px-4 py-8 text-sm text-muted">
      <p>Primary sources are NASA public-domain documents. This is an independent recreation, not affiliated with NASA.</p>
      <p class="mt-1">Every recreation says how close it is to the original, and every difference from the 1969–72 output is measured and recorded.</p>
    </footer>
  </body>
</html>
